# =============================================================================
# TravelSphere Platform — Local Development Environment
# =============================================================================
# Copy this file or edit directly. Docker Compose reads these defaults.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=travelsphere
POSTGRES_USER=travelsphere
POSTGRES_PASSWORD=TravelSphere@2024

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=Redis@2024

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=TravelSphere_JWT_Secret_Key_Min32Chars_2024

# ── Spring Profiles ──────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Config Server ────────────────────────────────────────────────────────────
# Uses local filesystem config-repo by default (no Git needed)
CONFIG_REPO_URI=file:///config-repo
CONFIG_REPO_SEARCHPATH=.
